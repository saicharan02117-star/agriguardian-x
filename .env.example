# AgriGuardian X environment template
# Copy to .env locally and fill only the values needed for your deployment.
# Never commit real secrets.

# Firebase web configuration (public client identifiers; security is enforced by Auth + Firestore rules)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional backend-only variables must remain server-side when introduced.
# GROQ_API_KEY=
