rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /conditions/{id} {
      allow read: if resource.data.reviewStatus == 'reviewed';
      allow write: if false;
    }
    match /sources/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /modelVersions/{id} {
      allow read: if resource.data.validated == true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);
    }
    match /users/{uid}/plants/{plantId} {
      allow read, create, update, delete: if owns(uid);
    }
    match /users/{uid}/inspections/{inspectionId} {
      allow read, create, update, delete: if owns(uid);
    }
    match /users/{uid}/treatmentPlans/{planId} {
      allow read, create, update, delete: if owns(uid);
    }
    match /users/{uid}/revisits/{revisitId} {
      allow read, create, update, delete: if owns(uid);
    }
    match /users/{uid}/feedback/{feedbackId} {
      allow read, create, update, delete: if owns(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
